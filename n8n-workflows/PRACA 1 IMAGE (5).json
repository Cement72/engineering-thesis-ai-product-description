    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let rawResponse = $input.item.json.response;\n\n// 1. Czyścimy tekst (gwiazdki, entery)\nlet cleanText = rawResponse.replace(/\\*/g, '')\n                           .replace(/[\\n\\r]+/g, ' ')\n                           .replace(/\\s\\s+/g, ' ')\n                           .trim();\n\n// 2. NOWOŚĆ: Uciekamy cudzysłowy, żeby nie rozwalały struktury JSON\nlet escapedText = cleanText.replace(/\"/g, '\\\\\"');\n\nreturn {\n  clean_description: escapedText\n};"
      },
