      "parameters": {
        "jsCode": "function stringToUUID(str) {\n  let h1 = 0xdeadbeef ^ 0, h2 = 0x41c6ce57 ^ 0;\n  for (let i = 0, ch; i < str.length; i++) {\n    ch = str.charCodeAt(i);\n    h1 = Math.imul(h1 ^ ch, 2654435761);\n    h2 = Math.imul(h2 ^ ch, 1597334677);\n  }\n  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507);\n  h1 ^= Math.imul(h2 ^ (h2 >>> 13), 3266489909);\n  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507);\n  h2 ^= Math.imul(h1 ^ (h1 >>> 13), 3266489909);\n\n  // Generowanie ciągu 32 znaków w formacie szesnastkowym\n  const hex1 = (h1 >>> 0).toString(16).padStart(8, '0');\n  const hex2 = (h2 >>> 0).toString(16).padStart(8, '0');\n  const hex3 = ((h1 ^ h2) >>> 0).toString(16).padStart(8, '0');\n  const hex4 = ((h1 + h2) >>> 0).toString(16).padStart(8, '0');\n\n  const raw = (hex1 + hex2 + hex3 + hex4).slice(0, 32);\n\n  // Sformatowanie na poprawny UUID v4 (8-4-4-4-12)\n  return `${raw.slice(0, 8)}-${raw.slice(8, 12)}-4${raw.slice(13, 16)}-a${raw.slice(17, 20)}-${raw.slice(20, 32)}`;\n}\n\n// Przetwarzanie elementów z n8n\nfor (const item of $input.all()) {\n  // Pobieramy treść tekstu (dostosuj ścieżkę, jeśli dane są w innym miejscu)\n  const content = item.json.data || JSON.stringify(item.json);\n  \n  // Generujemy stały UUID na podstawie tej treści\n  item.json.deterministic_id = stringToUUID(content);\n}\n\nreturn $input.all();"
      },
